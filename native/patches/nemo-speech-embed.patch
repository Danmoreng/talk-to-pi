diff --git a/CMakeLists.txt b/CMakeLists.txt
index 692cc1e..25d786d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100,3 +100,4 @@ option(GGML_VULKAN                   "Enable ggml Vulkan backend"            OFF
 option(GGML_METAL                    "Enable ggml Metal backend (Apple Silicon only)" OFF)
-set(NEMO_SPEECH_DEPENDENCY_PREFIX "${CMAKE_SOURCE_DIR}/.deps" CACHE PATH
+# Modified by Talk-to-Pi: keep dependency paths relative to embedded NeMo.
+set(NEMO_SPEECH_DEPENDENCY_PREFIX "${PROJECT_SOURCE_DIR}/.deps" CACHE PATH
     "User-writable prefix containing optional project-built dependencies")
@@ -211,3 +212,4 @@ if(GGML_CUDA)
     set(GGML_CUDA_GRAPHS ON CACHE BOOL "Enable ggml-cuda CUDA Graphs")
-    file(READ "${CMAKE_SOURCE_DIR}/ggml/src/ggml-cuda/conv-transpose-1d.cu" GGML_CUDA_CONV_TRANSPOSE_1D)
+    # Modified by Talk-to-Pi: resolve ggml inside the embedded NeMo project.
+    file(READ "${PROJECT_SOURCE_DIR}/ggml/src/ggml-cuda/conv-transpose-1d.cu" GGML_CUDA_CONV_TRANSPOSE_1D)
     if(NOT GGML_CUDA_CONV_TRANSPOSE_1D MATCHES "conv_transpose_1d_use_nanocodec_grouped2")
diff --git a/scripts/apply-ggml-patches.sh b/scripts/apply-ggml-patches.sh
--- a/scripts/apply-ggml-patches.sh
+++ b/scripts/apply-ggml-patches.sh
@@ -56,4 +56,7 @@ if git -C "${GGML}" rev-parse --git-dir >/dev/null 2>&1; then
-    mapfile -d '' patched_paths \
-        < <(GIT_INDEX_FILE="${expected_index}" git -C "${GGML}" \
-            diff --cached --name-only -z HEAD)
+    # Bash 3.2 on macOS has no mapfile; collect the NUL-delimited paths portably.
+    patched_paths=()
+    while IFS= read -r -d '' path; do
+        patched_paths+=("${path}")
+    done < <(GIT_INDEX_FILE="${expected_index}" git -C "${GGML}" \
+        diff --cached --name-only -z HEAD)
     GIT_INDEX_FILE="${current_index}" git -C "${GGML}" read-tree HEAD

