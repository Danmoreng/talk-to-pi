{
  "name": "talk-to-pi",
  "version": "0.1.0",
  "description": "Local, live Nemotron dictation for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danmoreng/talk-to-pi.git"
  },
  "homepage": "https://github.com/Danmoreng/talk-to-pi#readme",
  "bugs": {
    "url": "https://github.com/Danmoreng/talk-to-pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build": "node scripts/build-native.mjs",
    "install:local:pi": "bash scripts/install-local-pi.sh",
    "native:test": "ctest --test-dir native/build --output-on-failure",
    "local:pi": "bash scripts/local-pi.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "manifests",
    "licenses",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "speech-to-text",
    "asr",
    "voice-input",
    "nemotron",
    "nemo-speech",
    "local-ai"
  ]
}
