{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "talk-to-pi-engine-evaluation-corpus-item",
  "type": "object",
  "required": ["id", "audio", "language", "category"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "audio": { "type": "string" },
    "reference": { "type": "string" },
    "language": { "type": "string" },
    "category": { "type": "string" },
    "speaker": { "type": "string" },
    "durationMs": { "type": "number", "minimum": 0 },
    "speechEndMs": { "type": "number", "minimum": 0 },
    "expectedTerms": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
